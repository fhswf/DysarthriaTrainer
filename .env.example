ENV=development
VERSION=0.1.0
PROJECT_NAME=Sprechtrainer

UVICORN_HOST=0.0.0.0
UVICORN_PORT=8000

POSTGRES_USER=postgres
POSTGRES_PASSWORD=secret
POSTGRES_DB=demodb
POSTGRES_PORT=5432
# POSTGRES_HOST is the service name defined in compose.yaml
POSTGRES_HOST=postgres_timescale_pg_vector
POSTGRES_DRIVER=postgresql+asyncpg

PGADMIN_EMAIL=pgadmin@mail.de
PGADMIN_PASSWORD=secret

DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# path to migration scripts
MIGRATIONS_DIR=src/infrastructure/persistence/sqla/alembic

LOG_LEVEL=DEBUG
LOGGING_DIR=./logs
LOGGING_FILE=app.log

# Backup & Restore
# Set to a snapshot name to auto-restore on startup (e.g., RESTORE_SNAPSHOT=initial)
# Leave empty or comment out to skip auto-restore
RESTORE_SNAPSHOT=initial
# Volumes
HF_CACHE_DIR=/app/hf_cache
MODEL_DIR=/app/models

# Models
PHONEME_RECOGNITION_MODEL=TransformerCTC
TTS_MODEL=
ASR_MODEL=

TRANSFORMER_CTC_MODEL_URL=https://fh-swf.sciebo.de/s/E4ZHoYsiHyPi8eH/download
TRANSFORMER_CTC_MODEL_PATH=${MODEL_DIR}/checkpoint_commonvoice-german-100k_wavlm-large_unfrozen_encoder.pth
TRANSFORMER_CTC_CONFIG_DIR=${HF_CACHE_DIR}
4