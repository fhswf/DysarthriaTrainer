    {
      "id": "war-01-item",
      "exercise_id": "uee-01-lautbildung-plosive",
      "is_library_item": false,
      "item_type": "breathing",
      "instruction_id": "war-01-instruction",
      "instruction": {
        "id": "war-01-instruction",
        "exercise_id": "uee-01-lautbildung-plosive",
        "language": "de",
        "hint_text": "Diese Übungen dienen der Wahrnehmung und Schulung der Bauchatmung. Die Atmung lässt sich auch in den Flanken erspüren, an den Rippen, die sich sanft nach außen und innen bewegen.",
        "explanation_text": "Setzen Sie sich entspannt hin. Die Schultern sind locker, die Füße parallel am Boden. Legen Sie eine Hand auf den Bauch. Jede Übung fünf Mal wiederholen.",
        "safety_notes": null,
        "audio_instruction_url": "/mock-media/exercises/audio/WAR_01.mp3",
        "image_url": "/mock-media/exercises/images/pfad_zur_graphik.png",
        "display_order": 0,
        "created_at": "2026-01-09T12:00:00.000000Z",
        "updated_at": "2026-01-09T12:00:00.000000Z"
      },
      "display_order": 1,
      "repetitions": 1,
      "duration_seconds": 30,
      "metadata": {
        "title": "Atmung - Wahrnehmung",
        "scope": "Wahrnehmungsübungen"
      },
      "contents": [
        {
          "id": "war-01-content-1",
          "item_id": "war-01-item",
          "language": "de",
          "text_content": "Atmen Sie fünf Mal tief durch die Nase ein und langsam durch den Mund aus - spüren Sie die Bewegung im Bauch.",
          "demonstration_video_url": "/mock-media/exercises/video/WAR_01_1.mp4",
          "image_url": null,
          "phonetic_transcription": null,
          "audio_example_url": "/mock-media/exercises/audio/WAR_01_1.mp3",
          "difficulty": null,
          "info_type": null,
          "created_at": "2026-01-09T12:00:00.000000Z",
          "updated_at": "2026-01-09T12:00:00.000000Z"
        },
        {
          "id": "war-01-content-2",
          "item_id": "war-01-item",
          "language": "de",
          "text_content": "Halten Sie sich das rechte Nasenloch zu: Atmen Sie durch das linke Nasenloch ein und halten Sie kurz die Luft an. Wechseln Sie die Seite, halten sich nun das linke Nasenloch zu und atmen durch das rechts Nasenloch aus. Wiederholen Sie die Übung: Beginnen Sie mit der Einatmung drei Mal mit dem zugehaltenen rechten Nasenloch und drei Mal mit den zugehaltenen linken Nasenloch.",
          "demonstration_video_url": "/mock-media/exercises/video/WAR_01_2.mp4",
          "image_url": null,
          "phonetic_transcription": null,
          "audio_example_url": "/mock-media/exercises/audio/WAR_01_2.mp3",
          "difficulty": null,
          "info_type": null,
          "created_at": "2026-01-09T12:00:00.000000Z",
          "updated_at": "2026-01-09T12:00:00.000000Z"
        },
        {
          "id": "war-01-content-3",
          "item_id": "war-01-item",
          "language": "de",
          "text_content": "Genießen Sie für 30 Sekunden die tiefe Bauchatmung.",
          "demonstration_video_url": "/mock-media/exercises/video/WAR_01_3.mp4",
          "image_url": null,
          "phonetic_transcription": null,
          "audio_example_url": "/mock-media/exercises/audio/WAR_01_3.mp3",
          "difficulty": null,
          "info_type": null,
          "created_at": "2026-01-09T12:00:00.000000Z",
          "updated_at": "2026-01-09T12:00:00.000000Z"
        }
      ],
      "created_at": "2026-01-09T12:00:00.000000Z",
      "updated_at": "2026-01-09T12:00:00.000000Z"
