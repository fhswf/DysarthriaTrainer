      "metadata": {
        "title": "Übungen für den Unterkiefer",
        "scope": "Kräftigungsübungen"
      },
      "contents": [
        {
          "id": "uk-01-content-1",
          "item_id": "uk-01-item",
          "language": "de",
          "text_content": "Öffnen Sie Ihren Mund fünf Mal ganz weit, so weit Sie können, und wieder locker schließen",
          "demonstration_video_url": "/mock-media/exercises/video/UK_01_1.mp4",
          "image_url": null,
          "phonetic_transcription": null,
          "audio_example_url": "/mock-media/exercises/audio/UK_01_1.mp3",
          "difficulty": null,
          "info_type": null,
          "created_at": "2026-01-09T12:00:00.000000Z",
          "updated_at": "2026-01-09T12:00:00.000000Z"
        },
        {
          "id": "uk-01-content-2",
          "item_id": "uk-01-item",
          "language": "de",
          "text_content": "Bewegen Sie Ihren Unterkiefer fünf Mal locker von rechts nach links und wieder zurück",
          "demonstration_video_url": "/mock-media/exercises/video/UK_01_2.mp4",
          "image_url": null,
          "phonetic_transcription": null,
          "audio_example_url": "/mock-media/exercises/audio/UK_01_2.mp3",
          "difficulty": null,
          "info_type": null,
