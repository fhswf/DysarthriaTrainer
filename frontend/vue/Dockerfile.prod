# ./vue-app/Dockerfile.prod
FROM node:23-slim AS build-stage
WORKDIR /workspace/vue-app
COPY package*.json ./
RUN npm install
COPY . .
RUN npm run build  # produces static assets

# Use NGINX to serve the built files
FROM nginx:alpine AS production-stage
COPY --from=build-stage /workspace/vue-app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
