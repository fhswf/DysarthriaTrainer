# Ignore Docker-related files that should not be versioned
.docker/
compose.override.yml
compose.local.yml

# Ignore Docker build cache
**/__pycache__/
**/*.pyc
*.pid
*.seed
*.bak
*.swp

# Ignore environment and secrets
.env
!.env.example  # Keep a template

# Ignore volumes or shared mounts
volumes/
tmp/
*.sock

# Ignore node-related files if using JS frontend
node_modules/
npm-debug.log
yarn-error.log

# Ignore Python virtualenvs (if present)
venv/
backend/.venv/
.env/

# Ignore ai model checkpoints
*.pth

# Ignore IDE/editor files
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# Git-specific
.git/

# Backup snapshots (keep scripts, ignore data)
#backups/snapshots/*
!backups/snapshots/.gitkeep

# OS-specific
.DS_Store
Thumbs.db

#media & logs
*.webm
*.log

.cheatsheet.md
playground
backend/.github/docs/
config/